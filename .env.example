FLASK_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/bans.db
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SETTINGS_ENCRYPTION_KEY=
COOKIE_SECURE=0
FLASK_DEBUG=1
# Optional: set a Fernet key to persist encrypted gateway credentials across server instances.
# If omitted locally, the app creates instance/settings.key automatically. Back it up securely.
SETTINGS_ENCRYPTION_KEY=
